# Copy this file to ".env" and fill in real values. The real .env is
# git-ignored and must NEVER be committed. These are only the variable NAMES.

# Your Google AI Studio (Gemini) API key. Get one at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# A long random secret that acts as the "password" to use the AI endpoint.
# Only requests sending this value in the X-AI-Token header may trigger a
# (paid) Gemini call. Invent any hard-to-guess string.
AI_ACCESS_TOKEN=your-chosen-secret-token-here
